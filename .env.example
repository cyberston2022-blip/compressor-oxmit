# Copy to .env and fill in real values. Keep .env chmod 600 and NEVER commit it.

# ---- Telegram ----
BOT_TOKEN=123456789:REPLACE_ME
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=replace_me
# Comma-separated Telegram numeric user IDs. Empty => the first user who runs
# /start claims admin ownership (bootstrap mode).
ADMIN_TELEGRAM_IDS=
# Numeric private channel id (-100...). Empty => configure later with
# /setarchive or by forwarding a channel message to the bot.
ARCHIVE_CHANNEL_ID=

# ---- Local Bot API server (official tdlib build) ----
TBAPI_COMMIT=e3e9dd8e5b3d7ab8537cd5a10dc31d5ffa8f82d1
LOCAL_BOT_API_BASE=http://telegram-bot-api:8081
MAX_UPLOAD_MB=2000

# ---- SVT Encore ----
ENCRE_BASE=http://encore-web:8080
ENCRE_USER=bot
ENCRE_PASSWORD=replace_me_random

# ---- PostgreSQL ----
POSTGRES_USER=oxmit
POSTGRES_PASSWORD=replace_me_random
POSTGRES_DB=oxmit

# ---- Paths ----
MEDIA_HOST_DIR=/opt/oxmit/media
TMP_RETENTION_HOURS=24

# ---- Limits / resource protection ----
# NOTE: WORKER_REPLICAS must match WORKER_CONTAINER_NAMES (default names are
# oxmit-encore-worker-1 .. N). WORKER_REPLICAS=1 needs
# WORKER_CONTAINER_NAMES=oxmit-encore-worker-1.
WORKER_REPLICAS=2
MAX_SOURCE_GB=4
# Per-user fairness: concurrent processing slots (soft: users with a running
# job are scheduled behind users without one) and max queued+running jobs.
MAX_ACTIVE_PER_USER=1
MAX_PENDING_PER_USER=10
VIP_MAX_PENDING_PER_USER=30
MAX_JOBS_PER_HOUR_PER_USER=10
MAX_JOBS_PER_DAY=30
# Persistent queue capacity = accepted job RECORDS (metadata only; nothing is
# downloaded until a worker claims the job).
MAX_QUEUED_JOBS=5000
DISK_MIN_FREE_GB=40
DISK_PAUSE_FREE_GB=20
# Absolute admission floor: jobs whose reserved size (source + need factor)
# falls below this are rejected outright. Must be >= 1 (GiB).
ADMISSION_FLOOR_GB=5
# Live worker CPU tuner re-check interval. Valid range 30..3600 seconds.
TUNER_ACTIVE_WINDOW_S=180
JOB_RETRIES=2
STUCK_MINUTES=90

# ---- Duplicate detection ----
SIMILARITY_REUSE=true
SIMILARITY_MEAN_MAX=5
SIMILARITY_MAX_SINGLE=12
SIMILARITY_DURATION_TOL_S=2

# ---- Resilience patterns (adapted from ArgonsEncoder, reimplemented) ----
# Re-evaluated disk reservation accounting per active job.
ADMISSION_NEED_FACTOR=2.2
# Jobs that fail disk admission wait as 'deferred' and auto-start when
# capacity frees, instead of being rejected.
DISK_DEFER=true
# Bounded concurrent archive uploads.
MAX_CONCURRENT_UPLOADS=2
# Segmented (chunk-parallel) transcoding for jobs >= 15 min. Measured NO
# speedup with 2 workers on this VPS - keep false unless scaling workers.
SEGMENT_ENABLED=false
# Segmented tuning (only when SEGMENT_ENABLED=true).
SEGMENT_MIN_DURATION=900
SEGMENT_LENGTH=10
# botapi_data is mounted read-only into encore-worker (docker-compose.yml):
# the source is exposed to Encore through a token-free SYMLINK - no staging
# copy of multi-GB files. Requires the workers to have been recreated with
# that mount (docker compose up -d encore-worker).
WORKERS_READ_BOTAPI=true
# Output >= source*threshold is treated as no-gain.
NO_GAIN_THRESHOLD=0.98
# Oversized outputs are split into independently playable parts.
SPLIT_UPLOAD=true
SPLIT_SAFETY=0.85

# ---- Custom target size ----
TARGET_MIN_MB=5
TARGET_MAX_GB=8
MIN_VIDEO_KBPS=200

# ---- UI ----
PROGRESS_EDIT_SECONDS=4

# ---- Internal API secrets (random strings) ----
INTERNAL_SECRET=replace_me_random
INTERNAL_TEST_TOKEN=replace_me_random
# Test harness endpoints (/internal/test/*). Disabled by default (SEC-4) -
# they can synthesize media and submit encode jobs. Enable only where the
# harness is needed; rate limits apply either way.
# DOUBLE GATE: setting ENABLE_TEST_API=true alone is NOT enough — the routes
# stay disabled unless ENABLE_TEST_API_CONFIRM is also set to the exact
# sentinel below. Both variables must be present:
#   ENABLE_TEST_API=true
#   ENABLE_TEST_API_CONFIRM=I-UNDERSTAND-THIS-IS-PROD
ENABLE_TEST_API=false
#ENABLE_TEST_API_CONFIRM=
# Web monitoring panel (/panel, localhost-only). Empty = panel disabled.
ADMIN_PANEL_TOKEN=replace_me_random
# Panel cookies get the Secure flag by default (force-TLS on remote access;
# Secure is still accepted by browsers on http://localhost). Set to 0 ONLY for
# plain-HTTP local testing.
#PANEL_SECURE_COOKIES=0

# ---- Optional: backup failure alert + off-host replication (BUG-006) ----
# Chat that receives the backup-failure alert (defaults to the first
# ADMIN_TELEGRAM_IDS entry). Alerts travel through the LOCAL Bot API server.
#BACKUP_ALERT_CHAT_ID=
# rclone target for off-host backup copies, e.g. "remote:bucket/oxmit"
#BACKUP_RCLONE_TARGET=

TZ=UTC

# ---- Admin panel v2 (Phase: public access) ----
# Numeric Telegram ID of the owner (can demote admins; cannot be demoted).
OWNER_TELEGRAM_ID=123456789
# Public panel URL the /panel bot command shares with admins.
PANEL_PUBLIC_URL=https://YOUR-SERVER-IP:8090/panel

# ---- JIT queue / dispatcher (migration 015) ----
# Encode slots (0 = WORKER_REPLICAS). One slot = one video from download
# until its encode finishes; upload/delivery happen outside the slot.
ENCODE_SLOTS=0
# Jobs that may be downloaded ahead of a free encoder (overlaps download with
# encoding). 0 = strict just-in-time download.
PREFETCH_JOBS=0
LEASE_MINUTES=20
# Archive upload retries (with backoff) - an upload failure never re-encodes.
UPLOAD_RETRIES=5
# Remove the Local Bot API copy of a source once no active job needs it.
DELETE_BOTAPI_SOURCE=true
# The telegram-bot-api container mounts /media read-only (docker-compose.yml):
# outputs are uploaded via file:// instead of a multipart copy through HTTP.
# Falls back to a normal upload automatically if it fails.
BOTAPI_READS_MEDIA=true
# Private activity/moderation channel (default: the archive channel).
#LOG_CHANNEL_ID=
NAMING_TIMEOUT_MIN=30
SUPPORT_SESSION_MIN=10

# ---- EDU480 (single active profile) ----
EDU480_CRF=25
EDU480_PRESET=veryfast
EDU480_MAX_FPS=30
EDU480_AUDIO_KBPS=64
# <=480p H.264/AAC sources at or below this video bitrate are remuxed, not re-encoded.
EDU480_COMPLIANT_KBPS=700
